rules_version='2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authorization
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isCreator(createdBy) {
      return isAuthenticated() && request.auth.uid == createdBy;
    }

    // Validate required fields for TRR
    function validTRRCreate() {
      let data = request.resource.data;
      return data.keys().hasAll(['title', 'organizationId', 'userId', 'createdBy', 'createdAt', 'updatedAt'])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.createdBy == request.auth.uid
        && data.userId == request.auth.uid;
    }

    function validTRRUpdate() {
      let data = request.resource.data;
      // Prevent changing ownership or organization
      return (!data.diff(resource.data).affectedKeys().hasAny(['createdBy', 'organizationId', 'createdAt']))
        && data.updatedAt is timestamp;
    }

    // TRR Collection Rules
    match /trrs/{trrId} {
      // Read: Only owner can read their TRRs
      allow read: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );

      // Create: Authenticated users can create TRRs for themselves
      allow create: if isAuthenticated()
        && validTRRCreate()
        && request.resource.data.createdBy == request.auth.uid;

      // Update: Only owner can update their TRRs
      allow update: if isAuthenticated()
        && resource.data.createdBy == request.auth.uid
        && validTRRUpdate();

      // Delete: Only owner can delete their TRRs
      allow delete: if isAuthenticated()
        && resource.data.createdBy == request.auth.uid;
    }

    // POV Collection Rules
    match /povs/{povId} {
      allow read: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.owner == request.auth.uid ||
        request.auth.uid in resource.data.team
      );

      allow create: if isAuthenticated()
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if isAuthenticated()
        && (resource.data.createdBy == request.auth.uid || resource.data.owner == request.auth.uid);

      allow delete: if isAuthenticated()
        && resource.data.createdBy == request.auth.uid;
    }

    // Project Collection Rules
    match /projects/{projectId} {
      allow read: if isAuthenticated() && (
        resource.data.owner == request.auth.uid ||
        request.auth.uid in resource.data.team
      );

      allow create: if isAuthenticated()
        && request.resource.data.owner == request.auth.uid;

      allow update: if isAuthenticated()
        && resource.data.owner == request.auth.uid;

      allow delete: if isAuthenticated()
        && resource.data.owner == request.auth.uid;
    }

    // User Profile Collection Rules
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Organizations Collection Rules
    match /organizations/{orgId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // TODO: Add org admin role check
    }

    // Session/Activity Logs - Read-only for users, write for authenticated users
    match /activity_logs/{logId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; // Logs are immutable
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
