{
  "name": "obsidian-cortex-dc-connector",
  "version": "0.1.0",
  "description": "Obsidian plugin for Cortex Domain Consultant Platform integration",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
